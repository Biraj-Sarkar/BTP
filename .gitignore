
# ==========================================
# Python caches and generated files
# ==========================================
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# ==========================================
# Environment files and secrets
# ==========================================
**/.env
**/.env.*
!**/.env.example

# ==========================================
# Dataset privacy
# Keep the directory, but never commit its contents
# ==========================================
/datasets/raw/hospital/**
!/datasets/raw/hospital/.gitkeep

# ==========================================
# Annotation masks
# Ignore images only; retain annotation code and metadata
# ==========================================
/experiments/annotation/masks/**/*.png
/experiments/annotation/masks/**/*.jpg
/experiments/annotation/masks/**/*.jpeg
/experiments/annotation/masks/**/*.bmp
/experiments/annotation/masks/**/*.tif
/experiments/annotation/masks/**/*.tiff
/experiments/annotation/masks/**/*.webp
/experiments/annotation/masks/**/*.gif

# ==========================================
# Extraction-generated image outputs
# Keep directories, ignore all their contents
# ==========================================
/experiments/extraction/overlays/**
!/experiments/extraction/overlays/.gitkeep

/experiments/extraction/predicted_masks/**
!/experiments/extraction/predicted_masks/.gitkeep

/experiments/extraction/roi_crops/**
!/experiments/extraction/roi_crops/.gitkeep

# ==========================================
# Flutter generated files and caches
# Keep application source, platform source,
# pubspec.yaml, and other required project files
# ==========================================
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/.pub-cache/
flutter_app/.pub/
flutter_app/.idea/
flutter_app/.vscode/
flutter_app/.widget_preview/
flutter_app/android/.gradle/
flutter_app/android/.kotlin/
flutter_app/android/local.properties
flutter_app/android/key.properties
flutter_app/ios/Flutter/.last_build_id
flutter_app/ios/Flutter/ephemeral/
flutter_app/macos/Flutter/ephemeral/
flutter_app/linux/flutter/ephemeral/
flutter_app/windows/flutter/ephemeral/

# ==========================================
# General generated/build files
# ==========================================
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
